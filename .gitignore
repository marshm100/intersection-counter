data/
models/*.pt
models/*.onnx
# YOLO can auto-download weights into the repo root — never commit them
*.pt
*.onnx
dist/
build/
__pycache__/
*.pyc
*.egg-info/
.env
*.db

# Video files (proprietary — never commit)
*.mp4
*.avi
*.mov
*.mkv

# User-specific Claude state (settings.json with hooks IS committed)
.claude/settings.local.json
.claude/current-task.json
.claude/projects/
.claude/scheduled_tasks.lock

# Copy artifacts
requirements - Copy*.txt
*.local - Copy*.json

# Task log (admin only, machine-specific)
logs/

# Playwright MCP session traces (auto-generated console logs + page snapshots)
.playwright-mcp/

# Ad-hoc UI screenshots — debugging artifacts, not deliverables
screenshots/*
!screenshots/.gitkeep

# Generated OpenVINO model exports (bulky, regenerated on demand)
*_openvino_model/

# Sweep/run logs — verbose machine-generated output (tens of MB of convergence
# warnings), regenerated on demand. The small JSON artifacts beside them ARE kept.
evaluations/*.log
# Transient diagnostic dumps
kernel.errors.txt
*.errors.txt
runs/detect/
